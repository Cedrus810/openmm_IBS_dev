end

elec name envpot
  mg-auto
  dime 129 129 129
  cglen 85.995 71.259 73.833
  fglen 24.000 24.000 24.000
  cgcent -1.9024 72.7289 -7.4599
  fgcent 26.0951 61.9809 14.3367
  mol 1
  lpbe
  bcfl mdh
  ion charge 1 conc 0.16770 radius 2.0
  ion charge -1 conc 0.16770 radius 2.0
  pdie 1.0
  sdie 97.0
  chgm spl4
  srfm smol
  srad 1.4
  swin 0.3
  sdens 10.0
  temp 300.0
  calcenergy no
  calcforce no
  write pot dx envpot
end

